<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Player Directory | G.O.T. Games</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&display=swap" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
:root{
  color-scheme:light dark;
  --bg:#eef1f4;
  --card:#fff;
  --ink:#16212c;
  --mute:#5d6b79;
  --line:#d3dae1;
  --accent:#e5b82a;
  --font:"Bricolage Grotesque",system-ui,sans-serif;
}
@media(prefers-color-scheme:dark){
  :root{
    --bg:#10161c;
    --card:#19222b;
    --ink:#e9eef3;
    --mute:#98a6b3;
    --line:#2b3743;
  }
}
*{box-sizing:border-box}
body{
  margin:0;
  background:var(--bg);
  color:var(--ink);
  font-family:var(--font);
}
.wrap{
  max-width:950px;
  margin:auto;
  padding:20px 16px 50px;
}
header{
  padding:22px;
  background:var(--card);
  border:1px solid var(--line);
  border-top:4px solid var(--accent);
  border-radius:16px;
  margin-bottom:20px;
}
h1{
  font-size:clamp(2rem,6vw,3rem);
  margin:0;
  font-weight:800;
}
.subtitle{color:var(--mute);margin:5px 0 0}
.back{
  display:inline-block;
  margin-bottom:15px;
  color:var(--ink);
  text-decoration:none;
  font-weight:600;
}
.back:hover{text-decoration:underline}
.search{
  width:100%;
  padding:13px 15px;
  border:1px solid var(--line);
  border-radius:10px;
  background:var(--card);
  color:var(--ink);
  font:inherit;
  margin-bottom:18px;
  outline:none;
}
.search:focus{border-color:var(--accent)}
.stats{
  color:var(--mute);
  font-size:.9rem;
  margin:0 0 12px;
}
.player-list{
  display:grid;
  gap:10px;
}
.player{
  display:flex;
  align-items:center;
  gap:13px;
  padding:13px;
  background:var(--card);
  border:1px solid var(--line);
  border-radius:12px;
  color:var(--ink);
  text-decoration:none;
  transition:transform .15s,border-color .15s;
}
.player:hover{
  transform:translateY(-2px);
  border-color:var(--accent);
}
.avatar{
  width:48px;
  height:48px;
  flex-shrink:0;
  border-radius:50%;
  object-fit:cover;
  background:var(--line);
}
.avatar-placeholder{
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:1.3rem;
  font-weight:800;
}
.player-info{min-width:0;flex:1}
.username{
  font-weight:800;
  overflow-wrap:anywhere;
}
.badges{
  display:flex;
  flex-wrap:wrap;
  gap:5px;
  margin-top:4px;
}
.badge{
  display:inline-block;
  padding:3px 8px;
  border-radius:999px;
  font-size:.7rem;
  font-weight:800;
  letter-spacing:.03em;
}
.owner{background:#f5d36b;color:#493500}
.administrator{background:#ffd1d1;color:#8d2020}
.moderator{background:#cce4ff;color:#174d83}
.developer{background:#e4d1ff;color:#6233a0}
.vip{background:#ffd4ed;color:#90245f}
.verified{background:#c9f1d6;color:#176b39}
.member{background:#dce2e8;color:#46515c}
.empty{
  text-align:center;
  padding:35px 15px;
  background:var(--card);
  border:1px solid var(--line);
  border-radius:12px;
  color:var(--mute);
}
.loading{text-align:center;padding:35px;color:var(--mute)}
.error{color:#e05252}
footer{
  text-align:center;
  margin-top:30px;
  color:var(--mute);
  font-size:.82rem;
}
</style>
</head>

<body>
<div class="wrap">

  <a class="back" href="index.html">← Back to Schedule</a>

  <header>
    <h1>Player Directory</h1>
    <p class="subtitle">Meet the G.O.T. Games community.</p>
  </header>

  <input
    class="search"
    id="search"
    type="search"
    placeholder="Search players..."
    aria-label="Search players"
  >

  <p class="stats" id="stats">Loading players...</p>

  <main class="player-list" id="playerList">
    <div class="loading">Loading players...</div>
  </main>

  <footer>
    G.O.T. Games · Community Player Directory
  </footer>

</div>

<script>
const SUPABASE_URL =
  "https://tzgxkiucsjampbresqkw.supabase.co";

const SUPABASE_KEY =
  "sb_publishable_hOSPQ3wZ9TB3cqsj0ruHXQ_TLjEVN9E";

const supabaseClient = window.supabase.createClient(
  SUPABASE_URL,
  SUPABASE_KEY
);

const playerList = document.getElementById("playerList");
const searchInput = document.getElementById("search");
const stats = document.getElementById("stats");

let players = [];

const roleInfo = {
  owner:{label:"OWNER",className:"owner",priority:1},
  administrator:{label:"ADMINISTRATOR",className:"administrator",priority:2},
  moderator:{label:"MODERATOR",className:"moderator",priority:3},
  developer:{label:"DEVELOPER",className:"developer",priority:4},
  vip:{label:"VIP",className:"vip",priority:5},
  verified:{label:"VERIFIED",className:"verified",priority:6},
  member:{label:"MEMBER",className:"member",priority:7}
};

function getPrimaryRole(roles){
  return [...roles].sort((a,b)=>
    (roleInfo[a]?.priority ?? 99) -
    (roleInfo[b]?.priority ?? 99)
  )[0] || "member";
}

function renderPlayers(){
  const query = searchInput.value.trim().toLowerCase();

  const filtered = players.filter(player =>
    player.username.toLowerCase().includes(query)
  );

  stats.textContent =
    `${filtered.length} player${filtered.length===1?"":"s"} found`;

  playerList.replaceChildren();

  if(!filtered.length){
    const empty = document.createElement("div");
    empty.className = "empty";
    empty.textContent = query
      ? "No players match your search."
      : "No players found yet.";
    playerList.append(empty);
    return;
  }

  for(const player of filtered){
    const primaryRole = getPrimaryRole(player.roles);
    const role = roleInfo[primaryRole] || roleInfo.member;

    const link = document.createElement("a");
    link.className = "player";
    link.href =
      "profile.html?username=" +
      encodeURIComponent(player.username);

    if(player.avatar_url){
      const avatar = document.createElement("img");
      avatar.className = "avatar";
      avatar.src = player.avatar_url;
      avatar.alt = "";
      avatar.loading = "lazy";

      avatar.onerror = () => {
        const placeholder = document.createElement("div");
        placeholder.className = "avatar avatar-placeholder";
        placeholder.textContent =
          player.username.charAt(0).toUpperCase();
        avatar.replaceWith(placeholder);
      };

      link.append(avatar);
    }else{
      const placeholder = document.createElement("div");
      placeholder.className = "avatar avatar-placeholder";
      placeholder.textContent =
        player.username.charAt(0).toUpperCase();
      link.append(placeholder);
    }

    const info = document.createElement("div");
    info.className = "player-info";

    const name = document.createElement("div");
    name.className = "username";
    name.textContent = player.username;

    const badges = document.createElement("div");
    badges.className = "badges";

    for(const roleName of player.roles){
      const badgeInfo = roleInfo[roleName];
      if(!badgeInfo) continue;

      const badge = document.createElement("span");
      badge.className = "badge " + badgeInfo.className;
      badge.textContent = badgeInfo.label;
      badges.append(badge);
    }

    info.append(name, badges);
    link.append(info);
    playerList.append(link);
  }
}

async function loadPlayers(){
  playerList.replaceChildren();

  const loading = document.createElement("div");
  loading.className = "loading";
  loading.textContent = "Loading players...";
  playerList.append(loading);

  const [profilesResult, rolesResult] = await Promise.all([
    supabaseClient
      .from("profiles")
      .select("id, username, avatar_url")
      .order("username", {ascending:true}),

    supabaseClient
      .from("user_roles")
      .select("user_id, role")
  ]);

  if(profilesResult.error){
    console.error(profilesResult.error);
    playerList.replaceChildren();

    const error = document.createElement("div");
    error.className = "empty error";
    error.textContent =
      "Couldn't load players. Please refresh the page.";
    playerList.append(error);
    stats.textContent = "Player list unavailable";
    return;
  }

  if(rolesResult.error){
    console.error(rolesResult.error);
    playerList.replaceChildren();

    const error = document.createElement("div");
    error.className = "empty error";
    error.textContent =
      "Couldn't load player roles. Please check the database permissions.";
    playerList.append(error);
    stats.textContent = "Player roles unavailable";
    return;
  }

  const rolesByUser = {};

  for(const entry of rolesResult.data || []){
    if(!rolesByUser[entry.user_id]){
      rolesByUser[entry.user_id] = [];
    }
    rolesByUser[entry.user_id].push(entry.role);
  }

  players = (profilesResult.data || []).map(profile=>({
    id:profile.id,
    username:profile.username,
    avatar_url:profile.avatar_url,
    roles:rolesByUser[profile.id] || ["member"]
  }));

  players.sort((a,b)=>{
    const roleA = roleInfo[getPrimaryRole(a.roles)]?.priority ?? 99;
    const roleB = roleInfo[getPrimaryRole(b.roles)]?.priority ?? 99;

    if(roleA !== roleB) return roleA-roleB;

    return a.username.localeCompare(b.username);
  });

  renderPlayers();
}

searchInput.addEventListener("input",renderPlayers);

loadPlayers();
</script>
</body>
</html>
